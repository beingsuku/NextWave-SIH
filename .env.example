# Backend Server Port
PORT=3000

# Database Connection (PostgreSQL)
# Format: postgresql://username:password@host:port/database
# Local dev example (adjust host/port if using Docker or remote Postgres):
DATABASE_URL=postgresql://postgres:testpass@localhost:5432/sih_db

# JWT Secret for signing authentication tokens
# IMPORTANT: Change this to a strong random string in production
# DO NOT commit the real secret to git — use .env.example only in git
JWT_SECRET=your_secret_key_change_this_in_production_to_something_long_and_random

# Directory to store uploaded document images
UPLOAD_DIR=./uploads

# Max file size for document uploads (in MB)
MAX_FILE_SIZE_MB=10

# Environment (development, staging, production)
# In production, sensitive errors are hidden from client responses
NODE_ENV=development

# Optional: OCR/Face/Forensics API endpoints (when real services are integrated)
# OCR_API_URL=https://your-ocr-service.com/api
# FACE_API_URL=https://your-face-service.com/api
# FORENSICS_API_URL=https://your-forensics-service.com/api
